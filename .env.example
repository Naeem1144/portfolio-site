# Copy to .env.local and fill in. Never commit real credentials; .env* is gitignored.

# --- Contact form (required) -------------------------------------------------
# Where submissions are delivered, and the SMTP account to send from.
EMAIL_ADDRESS=you@example.com
# Gmail: an App Password, not your account password.
# https://myaccount.google.com/apppasswords
EMAIL_PASSWORD=

# --- Mail transport (optional) ----------------------------------------------
# Named service. Defaults to "gmail".
# EMAIL_SERVICE=gmail
# Set EMAIL_HOST to bypass the named-service shorthand and use raw SMTP.
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_SECURE=false

# --- Site (recommended) ------------------------------------------------------
# Deployed origin. Used for canonical, Open Graph, robots.txt and sitemap.xml.
# NEXT_PUBLIC_SITE_URL=https://your-domain.com
